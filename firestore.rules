// Regole di sicurezza del database Firestore di Casa Marchionni.
//
// Vanno copiate nella console Firebase: Firestore Database → Regole → Pubblica.
// Sostituisci i tre indirizzi con gli account Google personali di famiglia.
// (Gli indirizzi veri restano solo nella console, non in questo repository.)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function famiglia() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'email-di-andrea@gmail.com',
          'email-di-laura@gmail.com',
          'email-di-claudia@gmail.com'
        ];
    }

    // Dati condivisi della famiglia (spesa, da fare, liste, viaggi…):
    // tutte le collezioni principali tranne "users".
    match /{collection}/{docId} {
      allow read, write: if famiglia() && collection != 'users';
    }

    // Spazio privato di ciascuno (es. liste private): solo il proprietario.
    match /users/{uid}/{rest=**} {
      allow read, write: if famiglia() && request.auth.uid == uid;
    }
  }
}
